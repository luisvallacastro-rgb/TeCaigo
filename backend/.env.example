# Entorno local por defecto
NODE_ENV=development
PORT=3001

# En desarrollo seguimos usando SQLite local.
# En produccion se usara PostgreSQL administrado.
DATABASE_PROVIDER=sqlite
SQLITE_DATABASE_PATH=backend/data/tecaigo.sqlite

# Cuando contrates PostgreSQL administrado, pega aqui la URL privada o publica.
# Ejemplo:
# DATABASE_URL=postgresql://usuario:password@host:5432/tecaigo?sslmode=require
DATABASE_URL=

# Origen permitido para el frontend en produccion.
# Ejemplo:
# CORS_ORIGIN=https://app.tecaigo.com
CORS_ORIGIN=http://localhost:8084

# Claves futuras para sesiones y carga de comprobantes.
# Cambiar por valores secretos antes de produccion real.
SESSION_SECRET=cambiar_antes_de_produccion
UPLOAD_PROVIDER=local
